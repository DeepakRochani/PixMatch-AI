{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@pixmatch/types": ["../../packages/types/src/index.ts"],
      "@pixmatch/auth": ["../../packages/auth/src/index.ts"],
      "@pixmatch/config": ["../../packages/config/src/index.ts"],
      "@pixmatch/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/types/src/**/*.ts",
    "../../packages/auth/src/**/*.ts",
    "../../packages/config/src/**/*.ts",
    "../../packages/ui/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
