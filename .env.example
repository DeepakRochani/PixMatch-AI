# Application Settings
NODE_ENV=development
APP_NAME=PixMatch AI
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://pixmatch:pixmatch_secret@localhost:5432/pixmatch_db?schema=public"

# Redis & Background Workers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=super_secret_pixmatch_jwt_key_phase1_dev_only_change_in_prod
JWT_EXPIRES_IN=7d
REFRESH_SECRET=super_secret_pixmatch_refresh_key_phase1_dev_only
REFRESH_EXPIRES_IN=30d

# Storage Configuration
STORAGE_TYPE=platform
PLATFORM_STORAGE_LOCAL_DIR=./uploads
PLATFORM_STORAGE_BASE_URL=http://localhost:4000/uploads

# S3 Compatible (Phase 2 Ready)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloudflare R2 (Phase 2 Ready)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI Service (Phase 2 Ready)
AI_SERVICE_URL=http://localhost:8000

# Billing & Subscriptions (Phase 9)
BILLING_PROVIDER=mock
BILLING_CURRENCY=INR
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=

# Google Drive Cloud OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/storage/oauth/google/callback

# Dropbox OAuth
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=


