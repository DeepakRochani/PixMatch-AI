  studio     Studio                 @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  order      FulfillmentOrder       @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([order_id])
  @@index([action])
  @@index([created_at])
  @@map("fulfillment_audit_logs")
}

