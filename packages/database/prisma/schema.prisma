  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt @default(now())

  studio              Studio                    @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  resource            StudioResource?           @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([studio_id, resource_id])
  @@index([studio_id, day_of_week])
  @@index([studio_id, is_active])
