// -------------------------------------------------------------
// PHASE 28: CLIENT COMMUNICATION & RELATIONSHIP CENTER
// -------------------------------------------------------------

enum ConversationStatus {
  OPEN
  PENDING_CLIENT
  PENDING_STUDIO
  RESOLVED
  CLOSED
  ARCHIVED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageSenderType {
  STUDIO_USER
  CLIENT
  SYSTEM
  COPILOT
}

enum MessageDeliveryStatus {
  DRAFT
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum AttachmentStatus {
  PENDING
  UPLOADED
  SCANNING
  READY
  REJECTED
  DELETED
}

enum CommunicationAuditAction {
  CONVERSATION_CREATED
  MESSAGE_SENT
  MESSAGE_EDITED
  MESSAGE_DELETED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  PARTICIPANT_ADDED
  PARTICIPANT_REMOVED
  ATTACHMENT_UPLOADED
  ATTACHMENT_DELETED
  SAVED_REPLY_USED
  TEMPLATE_APPLIED
  RESOLVED
}

model ClientConversation {
  id                    String                         @id @default(uuid())
  studio_id             String
  client_id             String
  project_id            String?
  gallery_id            String?
  order_id              String?
  subject               String
  status                ConversationStatus             @default(OPEN)
  priority              ConversationPriority           @default(NORMAL)
  category              String                         @default("GENERAL") // GENERAL, INQUIRY, BOOKING, PROOFING, ORDER, FEEDBACK, SUPPORT
  assigned_to_user_id   String?
  last_message_at       DateTime?
  last_message_preview  String?
  unread_client_count   Int                            @default(0)
  unread_studio_count   Int                            @default(0)
  resolved_at           DateTime?
  resolved_by_user_id   String?
  is_starred            Boolean                        @default(false)
  tags                  String[]                       @default([])
  metadata              Json?
  created_at            DateTime                       @default(now())
  updated_at            DateTime                       @updatedAt

  studio                Studio                         @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  client                Client                         @relation(fields: [client_id], references: [id], onDelete: Cascade)
  project               StudioProject?                 @relation(fields: [project_id], references: [id], onDelete: SetNull)
  gallery               Gallery?                       @relation(fields: [gallery_id], references: [id], onDelete: SetNull)
  order                 FulfillmentOrder?              @relation(fields: [order_id], references: [id], onDelete: SetNull)
  assigned_to           User?                          @relation("ConversationAssignedUser", fields: [assigned_to_user_id], references: [id], onDelete: SetNull)
  messages              ClientMessage[]
  participants          ClientConversationParticipant[]
  assignments           ClientCommunicationAssignment[]
  audit_logs            ClientCommunicationAuditLog[]

  @@index([studio_id])
  @@index([client_id])
  @@index([project_id])
  @@index([gallery_id])
  @@index([order_id])
  @@index([assigned_to_user_id])
  @@index([status])
  @@index([priority])
  @@index([last_message_at])
  @@index([created_at])
  @@map("client_conversations")
}

model ClientConversationParticipant {
  id              String             @id @default(uuid())
  conversation_id String
  studio_id       String
  user_id         String?
  client_id       String?
  role            String             @default("MEMBER") // OWNER, ASSIGNEE, MEMBER, OBSERVER
  is_muted        Boolean            @default(false)
  last_read_at    DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  conversation    ClientConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  studio          Studio             @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  user            User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)
  client          Client?            @relation(fields: [client_id], references: [id], onDelete: SetNull)

  @@unique([conversation_id, user_id])
