  variant        FulfillmentProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)
  photos         FulfillmentOrderItemPhoto[]
  delivery_items FulfillmentDeliveryItem[]

  @@index([studio_id])
  @@index([order_id])
  @@index([product_id])
  @@map("fulfillment_order_items")
}

model FulfillmentOrderItemPhoto {
  id               String               @id @default(uuid())
  studio_id        String
  order_item_id    String
  photo_id         String
  photo_version_id String?
  notes            String?
  created_at       DateTime             @default(now())

  studio           Studio               @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  order_item       FulfillmentOrderItem @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
