  PHOTO_QUALITY
  SCENE_CLASSIFIER
  DUPLICATE_DETECTOR
  EVENT_INTELLIGENCE
}

model PhotoAIAnalysis {
  id                      String           @id @default(uuid())
  photo_id                String           @unique
  gallery_id              String
  studio_id               String
  model_version           String           @default("photo-intelligence:v1")
  quality_score           Float            @default(0.85)
  sharpness_score         Float            @default(0.85)
  blur_score              Float            @default(0.15)
  is_blurry               Boolean          @default(false)
  exposure_score          Float            @default(0.90)
  exposure_class          ExposureClass    @default(NORMAL)
  contrast_score          Float            @default(0.80)
  noise_score             Float            @default(0.10)
  composition_score       Float            @default(0.85)
  scene_category          String           @default("Unknown")
  scene_confidence        Float            @default(0.85)
  moment_category         String           @default("Unknown")
  moment_confidence       Float            @default(0.85)
  duplicate_group_id      String?
  near_duplicate_group_id String?
  perceptual_hash         String?          // 64-bit dHash hex string
  is_best_shot            Boolean          @default(false)
  best_shot_score         Float            @default(0.80)
  eyes_open_score         Float            @default(1.0)
  smile_score             Float            @default(0.80)
  people_count            Int              @default(0)
  analysis_status         ProcessingStatus @default(COMPLETED)
  analysis_error          String?
