  product     FulfillmentProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  order_items FulfillmentOrderItem[]

  @@index([studio_id])
  @@index([product_id])
  @@map("fulfillment_product_variants")
}

model FulfillmentOrder {
  id                  String                    @id @default(uuid())
  studio_id           String
  order_number        String
  proofing_session_id String?
  project_id          String?
  client_id           String?
  gallery_id          String?
  status              FulfillmentOrderStatus    @default(DRAFT)
  payment_status      FulfillmentPaymentStatus  @default(UNPAID)
  delivery_type       FulfillmentDeliveryType   @default(DIGITAL)
  currency            String                    @default("INR")
  subtotal            Float                     @default(0)
  tax_total           Float                     @default(0)
  discount_total      Float                     @default(0)
  total_amount        Float                     @default(0)
  paid_amount         Float                     @default(0)
  token_hash          String?                   @unique
  expires_at          DateTime?
  notes               String?
  internal_notes      String?
  client_confirmed_at DateTime?
  delivered_at        DateTime?
  cancelled_at        DateTime?
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt @default(now())

  studio              Studio                    @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  proofing_session    PhotoProofingSession?     @relation(fields: [proofing_session_id], references: [id], onDelete: SetNull)
  project             StudioProject?            @relation(fields: [project_id], references: [id], onDelete: SetNull)
  client              Client?                   @relation(fields: [client_id], references: [id], onDelete: SetNull)
  gallery             Gallery?                  @relation(fields: [gallery_id], references: [id], onDelete: SetNull)
  items               FulfillmentOrderItem[]
  payments            FulfillmentPayment[]
  deliveries          FulfillmentDelivery[]
  packages            FulfillmentPackage[]
  downloads           FulfillmentDownload[]
  shipping_address    FulfillmentAddress?
  status_history      FulfillmentStatusHistory[]
  audit_logs          FulfillmentAuditLog[]
  conversations       ClientConversation[]

  @@unique([studio_id, order_number])
  @@index([studio_id])
  @@index([studio_id, status])
  @@index([studio_id, payment_status])
  @@index([proofing_session_id])
  @@index([project_id])
  @@index([client_id])
  @@index([gallery_id])
  @@index([token_hash])
  @@index([created_at])
  @@map("fulfillment_orders")
}

model FulfillmentOrderItem {
  id             String                    @id @default(uuid())
  studio_id      String
  order_id       String
  product_id     String?
  variant_id     String?
  item_name      String
  product_type   FulfillmentProductType    @default(DIGITAL_DOWNLOAD)
  quantity       Int                       @default(1)
  unit_price     Float                     @default(0)
  subtotal       Float                     @default(0)
  tax            Float                     @default(0)
  discount       Float                     @default(0)
  total          Float                     @default(0)
