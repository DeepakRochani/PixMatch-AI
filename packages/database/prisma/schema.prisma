generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  STUDIO_OWNER
  STUDIO_MEMBER
  CLIENT
}

enum StudioMemberRole {
  OWNER
  ADMIN
  MANAGER
  PHOTOGRAPHER
  VIDEOGRAPHER
  EDITOR
  ASSISTANT
  PRODUCER
  SALES
  SUPPORT
  VIEWER
}

enum StudioMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
  REMOVED
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum MemberLeaveType {
  LEAVE
  HOLIDAY
  PERSONAL
  BLOCKED
}

enum GalleryAccessType {
  PUBLIC
  UNLISTED
  PASSWORD
  PRIVATE
}

enum GalleryStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StorageProviderType {
  PLATFORM
  GOOGLE_DRIVE
  DROPBOX
  ONEDRIVE
  S3
  CLOUDFLARE_R2
  GENERIC_S3
  EXTERNAL_URL
}

enum ProcessingStatus {
  PENDING
  UPLOADING
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobType {
  PHOTO_PROCESSING
  IMAGE_UPLOAD
  THUMBNAIL_GENERATION
  METADATA_EXTRACTION
  FACE_INDEXING
  AI_PROCESSING
  AI_FACE_SEARCH
  STORAGE_SYNC
  GALLERY_CLEANUP
  PHOTO_INTELLIGENCE
  EVENT_INTELLIGENCE
  COPILOT_PREPARE_GALLERY
  AUTOMATION_WORKFLOW
  CLIENT_ENGAGEMENT_REFRESH
  CLIENT_FOLLOWUP_SCAN
}

enum PhotoVersionType {
  ORIGINAL
  THUMBNAIL_SM
  THUMBNAIL_MD
  THUMBNAIL_LG
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  STUDIO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

// -------------------------------------------------------------
// USER MODEL
// -------------------------------------------------------------
model User {
  id            String             @id @default(uuid())
  name          String
  email         String             @unique
  password_hash String
  role          UserRole           @default(STUDIO_OWNER)
  avatar_url    String?
  is_suspended  Boolean            @default(false)
  suspended_at  DateTime?
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  memberships   StudioMembership[]
  audit_logs    AuditLog[]
  email_deliveries           EmailDelivery[]
  notification_preferences   NotificationPreference[]
  copilot_conversations      CopilotConversation[]
  copilot_actions            CopilotAction[]
  automation_workflows       AutomationWorkflow[]
  automation_approvals       AutomationApproval[]
  client_communication_drafts ClientCommunicationDraft[]
  business_transactions_created StudioBusinessTransaction[] @relation("BusinessTransactionCreator")
  business_audit_logs        StudioBusinessAuditLog[]
  assigned_conversations     ClientConversation[] @relation("ConversationAssignedUser")
  sent_client_messages       ClientMessage[]      @relation("ClientMessageSenderUser")
  conversation_participants  ClientConversationParticipant[]
  created_saved_replies      ClientSavedReply[]
  assigned_communications    ClientCommunicationAssignment[] @relation("CommunicationAssignedTo")
  assigned_by_communications ClientCommunicationAssignment[] @relation("CommunicationAssignedBy")
  assigned_clients           Client[]                        @relation("ClientAssignedUser")
  created_client_notes       ClientNote[]                    @relation("ClientNoteAuthor")
  client_merges_performed    ClientMergeAuditLog[]           @relation("ClientMergePerformedBy")
  sent_team_invitations      StudioTeamInvitation[]          @relation("TeamInvitedBy")
  support_cases_assigned     PlatformSupportCase[]           @relation("SupportCaseAdmin")
  support_cases_created      PlatformSupportCase[]           @relation("SupportCaseUser")
  incidents_owned            PlatformIncident[]              @relation("IncidentOwnerAdmin")

  @@index([email])
  @@map("users")
}

