  studio_id           String
  project_id          String?
  client_id           String?
  lead_id             String?
  title               String
  description         String?
  event_type          CalendarEventType         @default(SHOOT)
  status              CalendarEventStatus       @default(CONFIRMED)
  visibility          CalendarVisibility        @default(TEAM)
  start_at            DateTime
  end_at              DateTime
  timezone            String                    @default("UTC")
  all_day             Boolean                   @default(false)
  location            String?
  location_details    String?
  notes               String?                   // Internal private notes (never exposed to public)
  created_by          String?
  updated_by          String?
  cancelled_at        DateTime?
  cancelled_by        String?
  cancellation_reason CancellationReason?
  cancellation_note   String?
  external_provider   CalendarProvider?
  external_event_id   String?
