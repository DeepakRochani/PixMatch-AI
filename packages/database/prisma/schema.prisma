  project_id            String?
  client_id             String?
  vendor_id             String?
  category_id           String
  description           String
  amount_cents          Int
  tax_cents             Int                         @default(0)
  currency              String                      @default("INR")
  cost_type             FinancialCostClassification @default(DIRECT)
  expense_date          DateTime
  due_date              DateTime?
  status                FinancialExpenseStatus      @default(RECORDED)
  payment_status        FinancialPaymentStatus      @default(UNPAID)
  approval_status       FinancialApprovalStatus     @default(NOT_REQUIRED)
  approved_by_member_id String?
  approved_at           DateTime?
  reference             String?
  notes                 String?
  created_by_member_id  String
  created_at            DateTime                    @default(now())
  updated_at            DateTime                    @updatedAt @default(now())
  voided_at             DateTime?
  void_reason           String?

  studio                Studio                      @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  account               StudioFinancialAccount?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  category              StudioExpenseCategory       @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vendor                StudioVendor?               @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  payments              StudioExpensePayment[]
  payables              StudioPayable[]

  @@index([studio_id, status])
  @@index([studio_id, payment_status])
  @@index([studio_id, expense_date])
  @@index([studio_id, project_id])
  @@index([studio_id, vendor_id])
  @@index([studio_id, category_id])
  @@map("studio_expenses")
}

model StudioExpensePayment {
  id                   String                 @id @default(uuid())
  studio_id            String
  expense_id           String
  account_id           String
  amount_cents         Int
  payment_date         DateTime
  reference            String?
  created_by_member_id String
  idempotency_key      String
  created_at           DateTime               @default(now())

  studio               Studio                 @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  expense              StudioExpense          @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  account              StudioFinancialAccount @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@unique([studio_id, idempotency_key])
  @@index([studio_id, expense_id])
  @@index([studio_id, payment_date])
  @@map("studio_expense_payments")
}

model StudioReceivable {
  id                   String                     @id @default(uuid())
  studio_id            String
  client_id            String?
  project_id           String?
  booking_id           String?
  order_id             String?
  contract_id          String?
  description          String
  total_amount_cents   Int
  received_amount_cents Int                       @default(0)
  due_date             DateTime?
  currency             String                     @default("INR")
  status               FinancialReceivableStatus  @default(OPEN)
  created_at           DateTime                   @default(now())
  updated_at           DateTime                   @updatedAt @default(now())

  studio               Studio                     @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  reconciliations      StudioFinancialReconciliation[]

  @@index([studio_id, status])
  @@index([studio_id, due_date])
  @@index([studio_id, project_id])
  @@index([studio_id, client_id])
  @@map("studio_receivables")
}

model StudioPayable {
  id                   String                     @id @default(uuid())
  studio_id            String
  vendor_id            String?
  project_id           String?
  expense_id           String?
  description          String
  total_amount_cents   Int
  paid_amount_cents    Int                        @default(0)
  due_date             DateTime?
  currency             String                     @default("INR")
  status               FinancialPayableStatus     @default(OPEN)
  created_at           DateTime                   @default(now())
  updated_at           DateTime                   @updatedAt @default(now())

  studio               Studio                     @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  vendor               StudioVendor?              @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  expense              StudioExpense?             @relation(fields: [expense_id], references: [id], onDelete: SetNull)
  reconciliations      StudioFinancialReconciliation[]

  @@index([studio_id, status])
  @@index([studio_id, due_date])
  @@index([studio_id, vendor_id])
  @@index([studio_id, project_id])
  @@map("studio_payables")
}

model StudioBudget {
  id          String                    @id @default(uuid())
  studio_id   String
  name        String
  period_type FinancialBudgetPeriodType @default(MONTHLY)
  start_date  DateTime
  end_date    DateTime
  amount_cents Int
  category_id String?
  project_id  String?
  status      FinancialBudgetStatus     @default(ACTIVE)
  created_at  DateTime                  @default(now())
  updated_at  DateTime                  @updatedAt @default(now())

  studio      Studio                    @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  category    StudioExpenseCategory?    @relation(fields: [category_id], references: [id], onDelete: SetNull)
  entries     StudioBudgetEntry[]

  @@index([studio_id, status])
  @@index([studio_id, start_date, end_date])
  @@map("studio_budgets")
}

model StudioBudgetEntry {
  id                  String       @id @default(uuid())
  studio_id           String
  budget_id           String
  category_id         String?
  project_id          String?
  actual_amount_cents Int          @default(0)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt @default(now())

  studio              Studio       @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  budget              StudioBudget @relation(fields: [budget_id], references: [id], onDelete: Cascade)

  @@index([studio_id, budget_id])
  @@map("studio_budget_entries")
}

model StudioFinancialAudit {
  id               String                   @id @default(uuid())
  studio_id        String
  actor_member_id  String?
  entity_type      FinancialAuditEntityType
  entity_id        String
  action           String
  before_json      Json?
  after_json       Json?
  reason           String?
  created_at       DateTime                 @default(now())

  studio           Studio                   @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id, entity_type, entity_id])
  @@index([studio_id, created_at])
  @@map("studio_financial_audits")
}

model StudioFinancialReconciliation {
  id                    String                        @id @default(uuid())
  studio_id             String
  transaction_id        String?
  receivable_id         String?
  payable_id            String?
  expense_id            String?
  matched_amount_cents  Int
  status                FinancialReconciliationStatus @default(RECONCILED)
  notes                 String?
  reconciled_by_member_id String?
  created_at            DateTime                      @default(now())
  updated_at            DateTime                      @updatedAt @default(now())

  studio                Studio                        @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  receivable            StudioReceivable?             @relation(fields: [receivable_id], references: [id], onDelete: SetNull)
  payable               StudioPayable?                @relation(fields: [payable_id], references: [id], onDelete: SetNull)

  @@index([studio_id, status])
  @@index([studio_id, transaction_id])
  @@map("studio_financial_reconciliations")
}

// -------------------------------------------------------------
// PHASE 34: STUDIO FINANCIAL ACCOUNTING & GENERAL LEDGER 2.0
// -------------------------------------------------------------

enum ChartOfAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COGS
  OTHER_INCOME
  OTHER_EXPENSE
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
  VOID
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum AccountingReferenceType {
  RECEIVABLE
  PAYABLE
  EXPENSE
  BOOKING
  CONTRACT
  FULFILLMENT_ORDER
  REFUND
  MANUAL
  OPENING_BALANCE
  PERIOD_CLOSE
  RECONCILIATION
  TRANSFER
}

model StudioChartOfAccount {
  id                String                 @id @default(uuid())
  studio_id         String
  code              String
  name              String
  description       String?
  account_type      ChartOfAccountType
  normal_balance    AccountNormalBalance
  parent_account_id String?
  is_system         Boolean                @default(false)
  is_active         Boolean                @default(true)
  currency          String                 @default("USD")
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt @default(now())

  studio            Studio                 @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  parent_account    StudioChartOfAccount?  @relation("ChartOfAccountHierarchy", fields: [parent_account_id], references: [id], onDelete: SetNull)
  child_accounts    StudioChartOfAccount[] @relation("ChartOfAccountHierarchy")
  journal_lines     StudioJournalEntryLine[]
  debit_mappings    StudioAccountingMapping[] @relation("DebitMappingAccount")
  credit_mappings   StudioAccountingMapping[] @relation("CreditMappingAccount")

  @@unique([studio_id, code])
  @@index([studio_id, account_type])
  @@index([studio_id, is_active])
  @@map("studio_chart_of_accounts")
}

model StudioAccountingMapping {
  id                String               @id @default(uuid())
  studio_id         String
  event_type        String
  debit_account_id  String
  credit_account_id String
  description       String?
  is_active         Boolean              @default(true)
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt @default(now())

  studio            Studio               @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  debit_account     StudioChartOfAccount @relation("DebitMappingAccount", fields: [debit_account_id], references: [id], onDelete: Restrict)
  credit_account    StudioChartOfAccount @relation("CreditMappingAccount", fields: [credit_account_id], references: [id], onDelete: Restrict)

  @@unique([studio_id, event_type])
  @@index([studio_id, is_active])
  @@map("studio_accounting_mappings")
}

model StudioJournalEntry {
  id                   String                  @id @default(uuid())
  studio_id            String
  entry_number         String
  entry_date           DateTime
  posting_date         DateTime?
  description          String
  reference_type       AccountingReferenceType?
  reference_id         String?
  source_event_type    String?
  source_event_id      String?
  status               JournalEntryStatus      @default(DRAFT)
  currency             String                  @default("USD")
  total_debit_minor    BigInt                  @default(0)
  total_credit_minor   BigInt                  @default(0)
  reversal_of_entry_id String?
  idempotency_key      String?
  created_by           String
  posted_by            String?
  posted_at            DateTime?
  reversed_at          DateTime?
  period_id            String?
  created_at           DateTime                @default(now())
  updated_at           DateTime                @updatedAt @default(now())

  studio               Studio                  @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  period               StudioAccountingPeriod? @relation(fields: [period_id], references: [id], onDelete: SetNull)
  lines                StudioJournalEntryLine[]
  reversal_of          StudioJournalEntry?     @relation("JournalEntryReversals", fields: [reversal_of_entry_id], references: [id], onDelete: SetNull)
  reversals            StudioJournalEntry[]    @relation("JournalEntryReversals")

  @@unique([studio_id, entry_number])
  @@unique([studio_id, idempotency_key])
  @@index([studio_id, status])
  @@index([studio_id, entry_date])
  @@index([studio_id, reference_type, reference_id])
  @@map("studio_journal_entries")
}

model StudioJournalEntryLine {
  id                String              @id @default(uuid())
  studio_id         String
  journal_entry_id  String
  account_id        String
  description       String?
  debit_minor       BigInt              @default(0)
  credit_minor      BigInt              @default(0)
  currency          String              @default("USD")
  exchange_rate     Float               @default(1.0)
  base_debit_minor  BigInt              @default(0)
  base_credit_minor BigInt              @default(0)
  reference_type    String?
  reference_id      String?
  line_order        Int                 @default(0)
  created_at        DateTime            @default(now())

  studio            Studio              @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  journal_entry     StudioJournalEntry  @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  account           StudioChartOfAccount @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@index([studio_id, journal_entry_id])
  @@index([studio_id, account_id])
  @@index([studio_id, reference_type, reference_id])
  @@map("studio_journal_entry_lines")
}

model StudioAccountingPeriod {
  id          String                 @id @default(uuid())
  studio_id   String
  name        String
  start_date  DateTime
  end_date    DateTime
  status      AccountingPeriodStatus @default(OPEN)
  closed_at   DateTime?
  closed_by   String?
  created_at  DateTime               @default(now())
  updated_at  DateTime               @updatedAt @default(now())

  studio           Studio               @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  journal_entries  StudioJournalEntry[]

  @@unique([studio_id, name])
  @@index([studio_id, status])
  @@index([studio_id, start_date, end_date])
  @@map("studio_accounting_periods")
}

model StudioAccountingAudit {
  id              String   @id @default(uuid())
  studio_id       String
  actor_member_id String?
  entity_type     String
  entity_id       String
  action          String
  before_json     Json?
  after_json      Json?
  reason          String?
  created_at      DateTime @default(now())

  studio          Studio   @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id, entity_type, entity_id])
  @@index([studio_id, created_at])
  @@map("studio_accounting_audits")
}

// -------------------------------------------------------------
// PHASE 35: STUDIO TAX, GST & COMPLIANCE OPERATIONS 2.0
// -------------------------------------------------------------

enum TaxRegistrationType {
  UNREGISTERED
  COMPOSITION
  REGULAR
  SEZ
  EXPORT
  OTHER
}

enum TaxVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum TaxType {
  STANDARD
  ZERO_RATED
  EXEMPT
  NIL_RATED
  OUT_OF_SCOPE
  REVERSE_CHARGE
}

enum TaxItemSourceType {
  SERVICE
  PRODUCT
  PRINT
  DIGITAL
  SHIPPING
  OTHER
}

enum TaxPartyType {
  CLIENT
  VENDOR
}

enum TaxTransactionStatus {
  DRAFT
  CALCULATED
  POSTED
  VOID
  REVERSED
}

enum TaxComponent {
  CGST
  SGST
  IGST
  CESS
}

enum TaxItcStatus {
  ELIGIBLE
  PARTIAL
  INELIGIBLE
  PENDING_REVIEW
}

enum TaxAdjustmentType {
  CREDIT_NOTE
  DEBIT_NOTE
  TAX_ADJUSTMENT
}

enum TaxPeriodStatus {
  OPEN
  REVIEW
  READY_TO_FILE
  FILED
  CLOSED
}

enum TaxReconciliationStatus {
  MATCHED
  DIFFERENCE
  REVIEW_REQUIRED
  RESOLVED
}

model StudioTaxProfile {
  id                          String              @id @default(uuid())
  studio_id                   String              @unique
  legal_name                  String
  trade_name                  String?
  country                     String              @default("India")
  country_code                String              @default("IN")
  state                       String?
  state_code                  String?
  registration_type           TaxRegistrationType @default(REGULAR)
  gst_registered              Boolean             @default(true)
  gstin                       String?
  pan                         String?
  tan                         String?
  cin                         String?
  address_line_1              String?
  address_line_2              String?
  city                        String?
  postal_code                 String?
  tax_registration_date       DateTime?
  tax_period_type             String              @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL
  financial_year_start_month  Int                 @default(4) // April (India standard FY)
  default_currency            String              @default("INR")
  is_active                   Boolean             @default(true)
  created_at                  DateTime            @default(now())
  updated_at                  DateTime            @updatedAt @default(now())

  studio                      Studio              @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([studio_id, gstin])
  @@map("studio_tax_profiles")
}

model StudioTaxRegistration {
  id                  String                @id @default(uuid())
  studio_id           String
  registration_number String
  registration_type   TaxRegistrationType   @default(REGULAR)
  jurisdiction        String
  state_code          String
  effective_from      DateTime              @default(now())
  effective_to        DateTime?
  is_primary          Boolean               @default(false)
  is_active           Boolean               @default(true)
  verified_at         DateTime?
  verification_status TaxVerificationStatus @default(UNVERIFIED)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt @default(now())

  studio              Studio                @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id, state_code])
  @@index([studio_id, is_primary])
  @@map("studio_tax_registrations")
}

model StudioTaxJurisdiction {
  id                String          @id @default(uuid())
  studio_id         String
  country_code      String          @default("IN")
  state_code        String
  jurisdiction_code String
  name              String
  is_domestic       Boolean         @default(true)
  is_active         Boolean         @default(true)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt @default(now())

  studio            Studio          @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  tax_rates         StudioTaxRate[]
  tax_transactions  StudioTaxTransaction[]

  @@unique([studio_id, country_code, state_code])
  @@index([studio_id, is_active])
  @@map("studio_tax_jurisdictions")
}

model StudioTaxRate {
  id                String                 @id @default(uuid())
  studio_id         String
  jurisdiction_id   String?
  name              String
  code              String
  rate_basis_points Int                    // e.g. 1800 for 18%
  cgst_basis_points Int                    @default(0) // e.g. 900 for 9%
  sgst_basis_points Int                    @default(0) // e.g. 900 for 9%
  igst_basis_points Int                    @default(0) // e.g. 1800 for 18%
  cess_basis_points Int                    @default(0)
  effective_from    DateTime               @default(now())
  effective_to      DateTime?
  is_active         Boolean                @default(true)
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt @default(now())

  studio            Studio                 @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  jurisdiction      StudioTaxJurisdiction? @relation(fields: [jurisdiction_id], references: [id], onDelete: SetNull)
  tax_categories    StudioTaxCategory[]
  tax_transactions  StudioTaxTransaction[]
  item_mappings     StudioTaxItemMapping[]

  @@index([studio_id, code])
  @@index([studio_id, effective_from, effective_to])
  @@map("studio_tax_rates")
}

model StudioTaxCategory {
  id              String                 @id @default(uuid())
  studio_id       String
  code            String                 // e.g. "GST_18", "GST_EXEMPT", "GST_RCM"
  name            String
  description     String?
  tax_type        TaxType                @default(STANDARD)
  default_rate_id String?
  is_taxable      Boolean                @default(true)
  is_zero_rated   Boolean                @default(false)
  is_exempt       Boolean                @default(false)
  is_nil_rated    Boolean                @default(false)
  is_active       Boolean                @default(true)
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt @default(now())

  studio          Studio                 @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  default_rate    StudioTaxRate?         @relation(fields: [default_rate_id], references: [id], onDelete: SetNull)
  item_mappings   StudioTaxItemMapping[]
  tax_transactions StudioTaxTransaction[]

  @@unique([studio_id, code])
  @@index([studio_id, tax_type])
  @@map("studio_tax_categories")
}

model StudioTaxItemMapping {
  id              String            @id @default(uuid())
  studio_id       String
  tax_category_id String
  source_type     TaxItemSourceType @default(SERVICE)
  source_id       String?
  sac_code        String?           // e.g. "9983" (Photography / Creative services)
  hsn_code        String?           // e.g. "4911" (Printed photographs / albums)
  default_rate_id String?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt @default(now())

  studio          Studio            @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  tax_category    StudioTaxCategory @relation(fields: [tax_category_id], references: [id], onDelete: Cascade)
  default_rate    StudioTaxRate?    @relation(fields: [default_rate_id], references: [id], onDelete: SetNull)

  @@index([studio_id, source_type, source_id])
  @@index([studio_id, sac_code])
  @@index([studio_id, hsn_code])
  @@map("studio_tax_item_mappings")
}

model StudioTaxPartyProfile {
  id                      String       @id @default(uuid())
  studio_id               String
  party_type              TaxPartyType @default(CLIENT)
  party_id                String       // Client ID or Vendor ID
  legal_name              String
  tax_registration_number String?      // GSTIN / VAT / Tax ID
  pan                     String?
  country_code            String       @default("IN")
  state_code              String?      // 2-digit Indian State code e.g. "24" (Gujarat), "27" (Maharashtra)
  tax_residency           String       @default("DOMESTIC") // DOMESTIC, SEZ, INTERNATIONAL
  tax_exemption_status    String       @default("TAXABLE")  // TAXABLE, EXEMPT, SEZ_WITH_BOND
  is_registered           Boolean      @default(false)
  created_at              DateTime     @default(now())
  updated_at              DateTime     @updatedAt @default(now())

  studio                  Studio       @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  tax_transactions        StudioTaxTransaction[]

  @@unique([studio_id, party_type, party_id])
  @@index([studio_id, tax_registration_number])
  @@index([studio_id, state_code])
  @@map("studio_tax_party_profiles")
}

model StudioTaxTransaction {
  id                          String                    @id @default(uuid())
  studio_id                   String
  transaction_date            DateTime
  source_type                 String                    // INVOICE, PAYMENT, EXPENSE, ORDER, CONTRACT, etc.
  source_id                   String
  party_type                  TaxPartyType?
  party_id                    String?
  party_profile_id            String?
  tax_category_id             String?
  tax_rate_id                 String?
  jurisdiction_id             String?
  tax_period_id               String?
  origin_state_code           String?
  destination_state_code      String?
  taxable_amount_minor        Int                       @default(0)
  cgst_minor                  Int                       @default(0)
  sgst_minor                  Int                       @default(0)
  igst_minor                  Int                       @default(0)
  cess_minor                  Int                       @default(0)
  total_tax_minor             Int                       @default(0)
  currency                    String                    @default("INR")
  status                      TaxTransactionStatus      @default(DRAFT)
  itc_status                  TaxItcStatus              @default(ELIGIBLE)
  is_reverse_charge           Boolean                   @default(false)
  is_export_sez               Boolean                   @default(false)
  accounting_journal_entry_id String?
  idempotency_key             String?
  created_by                  String?
  posted_at                   DateTime?
  posted_by                   String?
  created_at                  DateTime                  @default(now())
  updated_at                  DateTime                  @updatedAt @default(now())

  studio                      Studio                    @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  party_profile               StudioTaxPartyProfile?    @relation(fields: [party_profile_id], references: [id], onDelete: SetNull)
  tax_category                StudioTaxCategory?        @relation(fields: [tax_category_id], references: [id], onDelete: SetNull)
  tax_rate                    StudioTaxRate?            @relation(fields: [tax_rate_id], references: [id], onDelete: SetNull)
  jurisdiction                StudioTaxJurisdiction?    @relation(fields: [jurisdiction_id], references: [id], onDelete: SetNull)
  tax_period                  StudioTaxPeriod?          @relation(fields: [tax_period_id], references: [id], onDelete: SetNull)
  lines                       StudioTaxTransactionLine[]
  adjustments                 StudioTaxAdjustment[]

  @@unique([studio_id, idempotency_key])
  @@index([studio_id, transaction_date])
  @@index([studio_id, source_type, source_id])
  @@index([studio_id, status])
  @@index([studio_id, tax_period_id])
  @@index([studio_id, accounting_journal_entry_id])
  @@map("studio_tax_transactions")
}

model StudioTaxTransactionLine {
  id                    String               @id @default(uuid())
  studio_id             String
  tax_transaction_id    String
  source_line_reference String?
  tax_code              String
  taxable_amount_minor  Int                  @default(0)
  rate_basis_points     Int                  @default(0)
  tax_amount_minor      Int                  @default(0)
  component             TaxComponent         @default(CGST)
  created_at            DateTime             @default(now())

