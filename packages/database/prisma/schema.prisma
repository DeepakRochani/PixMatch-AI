  @@index([studio_id])
  @@index([order_id])
  @@index([package_id])
  @@index([downloaded_at])
  @@map("fulfillment_downloads")
}

model FulfillmentAddress {
  id             String           @id @default(uuid())
  studio_id      String
  order_id       String           @unique
  full_name      String
  address_line1  String
  address_line2  String?
