  status           BusinessTransactionStatus @default(RECORDED)
  amount           Float
  currency         String                    @default("INR")
  transaction_date DateTime
  description      String
  reference        String?
  category         String                    // WEDDING, PORTRAIT, EQUIPMENT, TRAVEL, etc.
  source           String                    @default("MANUAL") // MANUAL, STRIPE, IMPORT, INVOICE
  notes            String?
  metadata         Json?
  is_void          Boolean                   @default(false)
  void_reason      String?
  voided_at        DateTime?
  created_by       String?
  updated_by       String?
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @updatedAt @default(now())

  studio           Studio                    @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  client           Client?                   @relation(fields: [client_id], references: [id], onDelete: SetNull)
  gallery          Gallery?                  @relation(fields: [gallery_id], references: [id], onDelete: SetNull)
  project          StudioProject?            @relation(fields: [project_id], references: [id], onDelete: SetNull)
  creator          User?                     @relation("BusinessTransactionCreator", fields: [created_by], references: [id], onDelete: SetNull)
  payment_schedules ProjectPaymentSchedule[]
  fulfillment_payments FulfillmentPayment[]

  @@index([studio_id])
  @@index([transaction_date])
  @@index([studio_id, transaction_date])
  @@index([studio_id, transaction_type])
  @@index([studio_id, category])
  @@index([studio_id, client_id])
  @@index([studio_id, gallery_id])
  @@index([studio_id, project_id])
  @@index([studio_id, status])
  @@index([is_void])
  @@map("studio_business_transactions")
}

model StudioBusinessGoal {
  id            String                 @id @default(uuid())
  studio_id     String
  title         String
  period_type   BusinessGoalPeriodType @default(MONTHLY)
  period_start  DateTime
  period_end    DateTime
  metric_type   BusinessGoalMetricType
  target_value  Float
  current_value Float                  @default(0)
  currency      String?
  status        BusinessGoalStatus     @default(ON_TRACK)
  notes         String?
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt @default(now())

  studio        Studio                 @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([studio_id, period_start, period_end])
  @@index([metric_type])
  @@map("studio_business_goals")
}

model StudioBusinessInsight {
  id               String                  @id @default(uuid())
  studio_id        String
  insight_type     BusinessInsightType
  severity         BusinessInsightSeverity @default(INFO)
  title            String
  description      String
  metric           String
  current_value    Float
  baseline_value   Float
  delta_percent    Float
  period_start     DateTime?
  period_end       DateTime?
  suggested_action String?
  status           BusinessInsightStatus   @default(ACTIVE)
  metadata         Json?
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt @default(now())

  studio           Studio                  @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([studio_id, insight_type])
  @@index([status])
  @@index([created_at])
  @@map("studio_business_insights")
}

model StudioBusinessForecast {
  id               String                     @id @default(uuid())
  studio_id        String
  metric_type      BusinessForecastMetric
  forecast_period  BusinessForecastPeriod
  period_start     DateTime
  period_end       DateTime
  predicted_value  Float
  lower_bound      Float
  upper_bound      Float
  confidence_score Float                      // 0.0 - 1.0
  confidence_level BusinessForecastConfidence @default(MODERATE)
  methodology      String                     // e.g. "3-month weighted moving average"
  data_points      Json                       // Historical values used
  currency         String?
  generated_at     DateTime                   @default(now())

  studio           Studio                     @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([studio_id, metric_type])
  @@index([forecast_period])
  @@map("studio_business_forecasts")
}

model StudioBusinessAuditLog {
  id          String   @id @default(uuid())
  studio_id   String
  user_id     String?
  action      String   // CREATE_TRANSACTION, UPDATE_TRANSACTION, VOID_TRANSACTION, CREATE_GOAL, etc.
  entity_type String   // TRANSACTION, GOAL, FORECAST, INSIGHT
  entity_id   String
  old_values  Json?
  new_values  Json?
  notes       String?
  created_at  DateTime @default(now())

  studio      Studio   @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([studio_id])
  @@index([studio_id, entity_type, entity_id])
  @@index([created_at])
  @@map("studio_business_audit_logs")
}

