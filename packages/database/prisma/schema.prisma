  ALBUM
  PHOTO_BOOK
  WALL_ART
  USB_DELIVERY
  CUSTOM_PRODUCT
  OTHER
}

enum FulfillmentOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  READY_FOR_DELIVERY
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
}

enum FulfillmentDeliveryStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  FAILED
  CANCELLED
}

enum FulfillmentItemStatus {
  PENDING
  APPROVED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

enum FulfillmentDeliveryType {
  DIGITAL
  PHYSICAL
  MIXED
}

enum FulfillmentAuditAction {
  ORDER_CREATED
  ITEM_ADDED
  ITEM_REMOVED
  ITEM_UPDATED
  PAYMENT_RECORDED
  STATUS_CHANGED
  PACKAGE_CREATED
  DELIVERY_CREATED
  FILE_DELIVERED
  DOWNLOAD_STARTED
  DOWNLOAD_COMPLETED
  DELIVERY_CONFIRMED
  ORDER_CANCELLED
  REFUND_RECORDED
}

model FulfillmentProduct {
  id              String                 @id @default(uuid())
  studio_id       String
  name            String
  description     String?
  type            FulfillmentProductType @default(DIGITAL_DOWNLOAD)
  is_active       Boolean                @default(true)
  is_digital      Boolean                @default(false)
