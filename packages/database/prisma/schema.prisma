// -------------------------------------------------------------
// STUDIO MEMBERSHIP (USER <-> STUDIO RBAC)
// -------------------------------------------------------------
model StudioMembership {
  id              String             @id @default(uuid())
  user_id         String
  studio_id       String
  role            StudioMemberRole   @default(PHOTOGRAPHER)
  title           String?
  department      String?
  bio             String?
  phone           String?
  skills          String[]           @default([])
  status          StudioMemberStatus @default(ACTIVE)
  timezone        String             @default("UTC")
  working_hours   Json?              // { days: [1,2,3,4,5], start_time: "09:00", end_time: "17:00" }
  notes           String?
  metadata        Json?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt @default(now())
  deactivated_at  DateTime?

  user            User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  studio          Studio             @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  leaves          StudioMemberLeave[]

  @@unique([user_id, studio_id])
  @@index([studio_id])
  @@index([user_id])
  @@index([studio_id, status])
  @@index([studio_id, department])
  @@index([studio_id, role])
  @@map("studio_memberships")
}

// -------------------------------------------------------------
// GALLERY MODEL (SCOPED TO STUDIO)
// -------------------------------------------------------------
model Gallery {
  id                      String            @id @default(uuid())
  studio_id               String
  title                   String
  slug                    String
  event_type              String            @default("Wedding")
  event_date              DateTime          @default(now())
  description             String?
  cover_photo_url         String?
  access_type             GalleryAccessType @default(PUBLIC)
  status                  GalleryStatus     @default(ACTIVE)
  password_hash           String?

  // AI Face Search Configuration & Metrics
  enable_ai_face_search   Boolean           @default(true)
  ai_indexing_status      ProcessingStatus  @default(PENDING)
  face_match_sensitivity  String            @default("MEDIUM")
  total_faces_detected    Int               @default(0)
  ai_indexed_photos_count Int               @default(0)

  // Client Gallery Settings & Permissions
  is_unlisted             Boolean           @default(false)
  expires_at              DateTime?
  downloads_enabled       Boolean           @default(true)
  download_originals_enabled Boolean        @default(true)
  bulk_download_enabled   Boolean           @default(true)
  watermark_mode          String            @default("NONE") // NONE, PREVIEW, DOWNLOAD
  client_views_count      Int               @default(0)

  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt

  studio                  Studio            @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  albums                  Album[]
  photos                  Photo[]
  clients                 Client[]
  client_galleries        ClientGallery[]
  client_activities       ClientActivity[]
  deliveries              GalleryDelivery[]
  face_detections         FaceDetection[]
  jobs                    ProcessingJob[]
  sync_jobs               StorageSyncJob[]
  client_sessions         GalleryClientSession[]
  favorites               GalleryFavorite[]
  selections              GallerySelection[]
  download_jobs           ClientDownloadJob[]
  analytics_daily         GalleryAnalyticsDaily[]
  ai_search_logs          AiSearchLog[]
  ai_analyses             PhotoAIAnalysis[]
  person_clusters         PersonCluster[]
  smart_albums            SmartAlbum[]
  event_intelligence      EventIntelligence?
  event_chapters          EventChapter[]
  event_stories           EventStory[]
  event_highlights        EventHighlight[]
  copilot_conversations   CopilotConversation[]
  copilot_recommendations CopilotRecommendation[]
  copilot_actions         CopilotAction[]
  automation_runs         AutomationRun[]
  client_insights                 ClientInsight[]
  client_followup_recommendations ClientFollowUpRecommendation[]
  client_communication_drafts     ClientCommunicationDraft[]
  business_transactions           StudioBusinessTransaction[]
  growth_opportunities           GrowthOpportunity[]
  project_links                  ProjectGalleryLink[]
  cull_sessions                  PhotoCullSession[]
  burst_groups                   PhotoBurstGroup[]
  edit_jobs                      PhotoEditJob[]
  export_jobs                    PhotoExportJob[]
  proofing_sessions              PhotoProofingSession[]
  fulfillment_orders             FulfillmentOrder[]
  conversations                  ClientConversation[]

  @@unique([studio_id, slug])
  @@index([studio_id])
  @@index([slug])
  @@map("galleries")
}

// -------------------------------------------------------------
// ALBUM MODEL (EVENT CATEGORIES / SUB-FOLDERS)
// -------------------------------------------------------------
model Album {
  id              String    @id @default(uuid())
  gallery_id      String
  studio_id       String
  title           String
  description     String?
  sort_order      Int       @default(0)
  cover_photo_id  String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  gallery         Gallery   @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  studio          Studio    @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  photos          Photo[]

  @@index([gallery_id])
  @@index([studio_id])
  @@map("albums")
}

// -------------------------------------------------------------
enum StorageMode {
  IMPORT
  CONNECTED
}

enum StorageSyncStatus {
  IDLE
  QUEUED
  SYNCING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum StorageConnectionStatus {
  ACTIVE
  CONNECTED
  SYNCING
  ERROR
  REAUTH_REQUIRED
  DISCONNECTED
  READY
}

// -------------------------------------------------------------
// PHOTO MODEL
// -------------------------------------------------------------
model Photo {
  id                    String               @id @default(uuid())
  studio_id             String
  gallery_id            String
  album_id              String?
  storage_provider      StorageProviderType  @default(PLATFORM)
  storage_path          String
  external_file_id      String?
  source_provider       StorageProviderType?
  source_file_id        String?
  source_path           String?
  source_modified_at    DateTime?
  source_status         String               @default("ACTIVE") // ACTIVE, SOURCE_MISSING, MODIFIED
  storage_connection_id String?
  original_url          String
  thumbnail_url         String?
  original_filename     String?
  file_hash             String?
  width                 Int?
  height                Int?
  file_size             BigInt               @default(0)
  mime_type             String               @default("image/jpeg")
  processing_status     ProcessingStatus     @default(PENDING)
  face_count            Int                  @default(0)
  is_face_indexed       Boolean              @default(false)
  sort_order            Int                  @default(0)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt @default(now())

  studio                Studio               @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  gallery               Gallery              @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  album                 Album?               @relation(fields: [album_id], references: [id], onDelete: SetNull)
  storage_connection    StorageConnection?   @relation(fields: [storage_connection_id], references: [id], onDelete: SetNull)
  versions              PhotoVersion[]
  face_detections       FaceDetection[]
  jobs                  ProcessingJob[]
  favorites             GalleryFavorite[]
  selections            GallerySelection[]
  ai_analysis           PhotoAIAnalysis?
  cluster_memberships   PersonClusterMember[]
  event_highlights      EventHighlight[]
  cover_for_chapters    EventChapter[]
  cull_decisions        PhotoCullDecision[]
  burst_group_members   PhotoBurstGroupMember[]
  selection_locks       PhotoSelectionLock[]
  review_actions        PhotoReviewAction[]
  edit_jobs             PhotoEditJob[]
  edit_suggestions      PhotoEditSuggestion[]
  edit_versions         PhotoEditVersion[]
  export_artifacts      PhotoExportArtifact[]
  proofing_items        PhotoProofingItem[]
  proofing_comments     PhotoProofingComment[]
  fulfillment_order_photos FulfillmentOrderItemPhoto[]
  fulfillment_package_items FulfillmentPackageItem[]
  fulfillment_downloads    FulfillmentDownload[]

  @@index([studio_id])
  @@index([gallery_id])
  @@index([album_id])
  @@index([gallery_id, file_hash])
  @@index([storage_connection_id])
  @@index([source_file_id])
  @@index([processing_status])
  @@index([sort_order])
  @@map("photos")
}

// -------------------------------------------------------------
// PHOTO VERSION MODEL (DERIVATIVES & THUMBNAILS)
// -------------------------------------------------------------
model PhotoVersion {
  id           String           @id @default(uuid())
  photo_id     String
  version_type PhotoVersionType
  storage_path String
  url          String
  width        Int?
  height       Int?
  file_size    BigInt           @default(0)
  mime_type    String           @default("image/webp")
  created_at   DateTime         @default(now())

  photo        Photo            @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@unique([photo_id, version_type])
  @@index([photo_id])
  @@map("photo_versions")
}

// -------------------------------------------------------------
// FACE DETECTION & EMBEDDINGS (PGVECTOR 512-DIM VECTOR SEARCH)
// -------------------------------------------------------------
model FaceDetection {
  id                  String   @id @default(uuid())
  photo_id            String
  gallery_id          String
  studio_id           String
  bounding_box        Json     // { x: float, y: float, width: float, height: float }
  confidence          Float    // Detection confidence score (0.0 to 1.0)
  face_quality_score  Float    @default(1.0) // Quality metric (sharpness, pose, illumination)
  embedding           Float[]  // 512-dimensional L2-normalized InsightFace vector
  embedding_model     String   @default("buffalo_l")
  embedding_dimension Int      @default(512)
  model_version       String   @default("1.0.0")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt @default(now())

  photo               Photo                @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  gallery             Gallery              @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  studio              Studio               @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  cluster_membership  PersonClusterMember?

  @@index([studio_id])
  @@index([gallery_id])
  @@index([photo_id])
  @@index([gallery_id, photo_id])
  @@index([studio_id, gallery_id])
  @@map("face_detections")
}

// -------------------------------------------------------------
// CLIENT CRM & DELIVERY MODELS (PHASE 7)
// -------------------------------------------------------------
enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  MERGED
}

enum ClientRelationshipStatus {
  NEW
  ACTIVE
  PROSPECTIVE
  PROJECT_IN_PROGRESS
  AWAITING_CLIENT
  COMPLETED
  RETURNING
  PAST
  DORMANT
  VIP
  ARCHIVED
  MERGED
}

enum ClientLifecycleStage {
  LEAD
  PROSPECT
  BOOKED_CLIENT
  ACTIVE_PROJECT
  DELIVERED_CLIENT
  PAST_CLIENT
  NEW_CLIENT
  ACTIVE_CLIENT
  PROJECT_COMPLETED
  RETURNING_CLIENT
  DORMANT_CLIENT
  ARCHIVED
  INACTIVE
}

enum ClientCustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  URL
}

enum ClientImportantDateType {
  ANNIVERSARY
  BIRTHDAY
  CHILD_BIRTHDAY
  SESSION_ANNIVERSARY
  CONTRACT_RENEWAL
  EVENT_DATE
  COMPANY_MILESTONE
  CUSTOM
  OTHER
}

enum DeliveryStatus {
  NOT_SENT
  QUEUED
  SENT
  OPENED
  ACTIVE
  FAILED
  EXPIRED
  COMPLETED
}

model Client {
  id              String            @id @default(uuid())
  studio_id       String
  gallery_id      String?
  first_name      String?
  last_name       String?
  name            String
  email           String
  phone           String?
  company         String?
  notes           String?           // Internal private photographer notes (never exposed publicly)
  tags            String[]          @default([])
  status          ClientStatus      @default(ACTIVE)
  relationship_status ClientRelationshipStatus @default(NEW)
  lifecycle_stage     ClientLifecycleStage     @default(NEW_CLIENT)
  preferred_channel   String?                  @default("EMAIL")
  preferred_language  String?                  @default("en")
  timezone            String?                  @default("UTC")
  source              String?
