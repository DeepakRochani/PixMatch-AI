  @@index([studio_id])
  @@index([studio_id, resource_type])
  @@index([studio_id, status])
  @@map("studio_resources")
}

model CalendarResourceAssignment {
  id                  String                    @id @default(uuid())
  studio_id           String
  calendar_event_id   String
  resource_id         String
  role                String?
