// -------------------------------------------------------------
enum BillingInterval {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

model Subscription {
  id                      String             @id @default(uuid())
  studio_id               String             @unique
  plan                    SubscriptionPlan   @default(FREE)
  status                  SubscriptionStatus @default(ACTIVE)
  billing_interval        BillingInterval    @default(MONTHLY)
  currency                String             @default("INR")
  provider                String             @default("STRIPE") // STRIPE, MOCK
  provider_customer_id    String?
  provider_subscription_id String?           @unique
  provider_price_id       String?
  cancel_at_period_end    Boolean            @default(false)
  current_period_start    DateTime           @default(now())
  current_period_end      DateTime           @default(now())
  trial_start             DateTime?
  trial_end               DateTime?
  canceled_at             DateTime?

  // Plan Quotas & Limits
  storage_limit_bytes     BigInt             @default(2147483648) // 2GB Free default
  photo_limit             Int                @default(500)
  ai_search_limit         Int                @default(50)
  max_galleries           Int?               // null = unlimited
  max_clients             Int?               // null = unlimited
  max_team_members        Int?               // null = unlimited

  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt

  studio                  Studio             @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  invoices                Invoice[]

  @@index([provider_customer_id])
  @@index([provider_subscription_id])
  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

model Invoice {
  id                  String        @id @default(uuid())
  studio_id           String
  subscription_id     String?
  provider_invoice_id String        @unique
  amount              Int           // Stored in minor units (e.g. paisa or cents)
  currency            String        @default("INR")
  status              InvoiceStatus @default(PAID)
  invoice_date        DateTime      @default(now())
  paid_at             DateTime?
  hosted_invoice_url  String?
  pdf_url             String?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  studio              Studio        @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  subscription        Subscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@index([studio_id])
  @@index([subscription_id])
  @@index([status])
  @@map("invoices")
}

model BillingWebhookEvent {
  id                String                  @id @default(uuid())
  provider          String                  @default("STRIPE")
  provider_event_id String                  @unique
  event_type        String
  payload           Json
  status            WebhookProcessingStatus @default(PENDING)
  error_message     String?
  received_at       DateTime                @default(now())
  processed_at      DateTime?

  @@index([provider_event_id])
