model FulfillmentPayment {
  id             String                    @id @default(uuid())
  studio_id      String
  order_id       String
  transaction_id String?
  amount         Float
  currency       String                    @default("INR")
  payment_method String?
  reference      String?
  status         FulfillmentPaymentStatus  @default(PAID)
  idempotency_key String?
  notes          String?
  metadata       Json?
  created_by     String?
  created_at     DateTime                  @default(now())

  studio         Studio                    @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  order          FulfillmentOrder          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  transaction    StudioBusinessTransaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@unique([studio_id, idempotency_key])
  @@index([studio_id])
  @@index([order_id])
  @@index([transaction_id])
  @@map("fulfillment_payments")
}

model FulfillmentDelivery {
  id                    String                    @id @default(uuid())
  studio_id             String
  order_id              String
  delivery_type         FulfillmentDeliveryType   @default(PHYSICAL)
  status                FulfillmentDeliveryStatus @default(PENDING)
