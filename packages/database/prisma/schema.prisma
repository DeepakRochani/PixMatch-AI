model FulfillmentPackageItem {
  id               String             @id @default(uuid())
  studio_id        String
  package_id       String
  photo_id         String
  photo_version_id String?
  created_at       DateTime           @default(now())

  studio           Studio             @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  package          FulfillmentPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)
  photo            Photo              @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@unique([package_id, photo_id])
  @@index([studio_id])
  @@index([package_id])
  @@index([photo_id])
  @@map("fulfillment_package_items")
}

model FulfillmentDownload {
