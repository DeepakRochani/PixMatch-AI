// =============================================================
// PHASE 24: ADVANCED MEDIA CULLING, EDITING & POST-PRODUCTION
// =============================================================

enum CullSessionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum CullDecisionType {
  UNREVIEWED
  AI_RECOMMENDED_KEEP
  AI_RECOMMENDED_REJECT
  AI_RECOMMENDED_MAYBE
  PHOTOGRAPHER_KEEP
  PHOTOGRAPHER_REJECT
  PHOTOGRAPHER_MAYBE
  LOCKED
  EXPORTED
}

enum EditJobStatus {
  QUEUED
  PROCESSING
  AI_SUGGESTED
  WAITING_APPROVAL
  APPROVED
  RENDERING
  COMPLETED
  FAILED
  CANCELLED
}

enum EditPresetType {
  SYSTEM
  STUDIO
  USER
}

enum EditVersionType {
  ORIGINAL
  EDIT_PREVIEW
  EDITED
  EXPORT
}

enum ExportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExportFormat {
  JPEG
  WEBP
  PNG
}

enum ExportQuality {
  WEB
  HIGH_QUALITY
  PRINT
}

enum MetadataPolicy {
  KEEP_ALL
  STRIP_LOCATION
  STRIP_ALL
  CUSTOM
}

model PhotoCullSession {
  id              String            @id @default(uuid())
  studio_id       String
  gallery_id      String
  project_id      String?
  name            String
  status          CullSessionStatus @default(IN_PROGRESS)
  total_photos    Int               @default(0)
  reviewed_count  Int               @default(0)
  keep_count      Int               @default(0)
  reject_count    Int               @default(0)
  maybe_count     Int               @default(0)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt @default(now())

  studio          Studio            @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  gallery         Gallery           @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  project         StudioProject?    @relation(fields: [project_id], references: [id], onDelete: SetNull)
  decisions       PhotoCullDecision[]
  review_actions  PhotoReviewAction[]

  @@index([studio_id])
  @@index([gallery_id])
  @@index([project_id])
  @@index([studio_id, status])
  @@map("photo_cull_sessions")
}

model PhotoCullDecision {
  id                String            @id @default(uuid())
  studio_id         String
  session_id        String
  photo_id          String
  decision          CullDecisionType  @default(UNREVIEWED)
  ai_score          Float             @default(0.0)
  ai_recommendation String?           // KEEP, REJECT, MAYBE
  ai_confidence     Float             @default(0.0)
  ai_reasons        Json?             // string array of factual explanations
  ai_warnings       Json?             // string array of warnings
  notes             String?
  decided_by        String?
  decided_at        DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt @default(now())

  studio            Studio            @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  session           PhotoCullSession  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  photo             Photo             @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  edit_jobs         PhotoEditJob[]

  @@unique([session_id, photo_id])
  @@index([studio_id])
  @@index([session_id])
  @@index([photo_id])
  @@index([studio_id, decision])
  @@map("photo_cull_decisions")
}

model PhotoBurstGroup {
  id                      String                  @id @default(uuid())
  studio_id               String
  gallery_id              String
  project_id              String?
  representative_photo_id String?
  photo_count             Int                     @default(0)
  avg_similarity          Float                   @default(0.0)
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt @default(now())

  studio                  Studio                  @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  gallery                 Gallery                 @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  project                 StudioProject?          @relation(fields: [project_id], references: [id], onDelete: SetNull)
  members                 PhotoBurstGroupMember[]

  @@index([studio_id])
  @@index([gallery_id])
  @@index([project_id])
  @@map("photo_burst_groups")
}

model PhotoBurstGroupMember {
  id              String          @id @default(uuid())
  studio_id       String
  burst_group_id  String
  photo_id        String
  rank            Int             @default(0)
  similarity_score Float          @default(1.0)
  capture_order   Int             @default(0)
  created_at      DateTime        @default(now())

  studio          Studio          @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  burst_group     PhotoBurstGroup @relation(fields: [burst_group_id], references: [id], onDelete: Cascade)
  photo           Photo           @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@unique([burst_group_id, photo_id])
  @@index([studio_id])
  @@index([burst_group_id])
  @@index([photo_id])
  @@map("photo_burst_group_members")
}

model PhotoSelectionLock {
  id              String          @id @default(uuid())
  studio_id       String
  photo_id        String
  locked_by       String
  expires_at      DateTime
  created_at      DateTime        @default(now())

  studio          Studio          @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  photo           Photo           @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@unique([photo_id])
  @@index([studio_id])
  @@index([photo_id])
  @@index([expires_at])
  @@map("photo_selection_locks")
}

model PhotoReviewAction {
  id                String            @id @default(uuid())
  studio_id         String
  session_id        String
  photo_id          String
  action_type       String            // KEEP, REJECT, MAYBE, RESET, BULK_KEEP, BULK_REJECT, BULK_MAYBE
  previous_decision CullDecisionType
  new_decision      CullDecisionType
  actor_id          String?
  undone            Boolean           @default(false)
  created_at        DateTime          @default(now())

  studio            Studio            @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  session           PhotoCullSession  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  photo             Photo             @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([session_id])
  @@index([photo_id])
  @@index([created_at])
  @@map("photo_review_actions")
}

model PhotoEditJob {
  id                String              @id @default(uuid())
  studio_id         String
  project_id        String?
  gallery_id        String
  photo_id          String
  cull_decision_id  String?
  status            EditJobStatus       @default(QUEUED)
  priority          String              @default("NORMAL") // URGENT, HIGH, NORMAL, LOW
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt @default(now())

  studio            Studio              @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  gallery           Gallery             @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  project           StudioProject?      @relation(fields: [project_id], references: [id], onDelete: SetNull)
  photo             Photo               @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  cull_decision     PhotoCullDecision?  @relation(fields: [cull_decision_id], references: [id], onDelete: SetNull)
  suggestions       PhotoEditSuggestion[]
  versions          PhotoEditVersion[]

  @@index([studio_id])
  @@index([gallery_id])
  @@index([project_id])
  @@index([photo_id])
  @@index([studio_id, status])
  @@map("photo_edit_jobs")
}

model PhotoEditPreset {
  id              String          @id @default(uuid())
  studio_id       String
  name            String
  description     String?
  preset_type     EditPresetType  @default(STUDIO)
  parameters      Json            // EditParametersDTO
  is_default      Boolean         @default(false)
  created_by      String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt @default(now())

  studio          Studio          @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([studio_id, preset_type])
  @@map("photo_edit_presets")
}

model PhotoEditSuggestion {
  id                String          @id @default(uuid())
  studio_id         String
  edit_job_id       String
  photo_id          String
  provider          String          @default("LOCAL_MOCK")
  parameter_changes Json            // Partial<EditParametersDTO>
  reason            String
  confidence        Float           @default(0.85)
  is_applied        Boolean         @default(false)
  created_at        DateTime        @default(now())

  studio            Studio          @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  edit_job          PhotoEditJob    @relation(fields: [edit_job_id], references: [id], onDelete: Cascade)
  photo             Photo           @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([edit_job_id])
  @@index([photo_id])
  @@map("photo_edit_suggestions")
}

model PhotoEditVersion {
  id                String            @id @default(uuid())
  studio_id         String
  edit_job_id       String
  photo_id          String
  version_number    Int               @default(1)
  version_type      EditVersionType   @default(EDITED)
  parameters        Json              // EditParametersDTO
  storage_path      String?
  preview_url       String?
  render_status     String            @default("COMPLETED") // PENDING, RENDERING, COMPLETED, FAILED
  created_by        String?
  created_at        DateTime          @default(now())

  studio            Studio            @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  edit_job          PhotoEditJob      @relation(fields: [edit_job_id], references: [id], onDelete: Cascade)
  photo             Photo             @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  export_artifacts  PhotoExportArtifact[]

  @@index([studio_id])
  @@index([edit_job_id])
  @@index([photo_id])
  @@map("photo_edit_versions")
}

model PhotoExportJob {
  id                String          @id @default(uuid())
  studio_id         String
  project_id        String?
  gallery_id        String
  preset_id         String?
  status            ExportJobStatus @default(QUEUED)
  total_items       Int             @default(0)
  processed_items   Int             @default(0)
  target_format     ExportFormat    @default(JPEG)
  quality_level     ExportQuality   @default(HIGH_QUALITY)
  metadata_policy   MetadataPolicy  @default(STRIP_LOCATION)
  watermark_enabled Boolean         @default(false)
  output_path       String?
  created_by        String?
  created_at        DateTime        @default(now())
  completed_at      DateTime?

  studio            Studio          @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  gallery           Gallery         @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  project           StudioProject?  @relation(fields: [project_id], references: [id], onDelete: SetNull)
  artifacts         PhotoExportArtifact[]

  @@index([studio_id])
  @@index([gallery_id])
  @@index([project_id])
  @@index([studio_id, status])
  @@map("photo_export_jobs")
}

model PhotoExportPreset {
  id                String          @id @default(uuid())
  studio_id         String
  name              String
  description       String?
  format            ExportFormat    @default(JPEG)
  max_width         Int?
  max_height        Int?
  quality           Int             @default(90)
  metadata_policy   MetadataPolicy  @default(STRIP_LOCATION)
  watermark_policy  String          @default("NONE") // NONE, GALLERY_DEFAULT, CUSTOM
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt @default(now())

  studio            Studio          @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@map("photo_export_presets")
}

model PhotoExportArtifact {
  id                String            @id @default(uuid())
  studio_id         String
  export_job_id     String
  photo_id          String
  edit_version_id   String?
  storage_key       String
  url               String
  file_size         BigInt            @default(0)
  checksum          String?
  format            ExportFormat      @default(JPEG)
  width             Int?
  height            Int?
  created_at        DateTime          @default(now())

  studio            Studio            @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  export_job        PhotoExportJob    @relation(fields: [export_job_id], references: [id], onDelete: Cascade)
  photo             Photo             @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  edit_version      PhotoEditVersion? @relation(fields: [edit_version_id], references: [id], onDelete: SetNull)

  @@index([studio_id])
  @@index([export_job_id])
  @@index([photo_id])
  @@map("photo_export_artifacts")
}

// -------------------------------------------------------------
// PHASE 25: CLIENT PROOFING & SELECTION
// -------------------------------------------------------------

enum ProofingSessionStatus {
  DRAFT
  ACTIVE
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  LOCKED
  EXPIRED
}

enum ProofingItemStatus {
  UNREVIEWED
  SELECTED
  FAVORITE
  REJECTED
}

enum ProofingCommentType {
  GENERAL
  PINPOINT_COORDINATE
  RETOUCH_REQUEST
  CROP_REQUEST
}

enum ProofingReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  PARTIAL_APPROVAL
}

model PhotoProofingSession {
  id                String                 @id @default(uuid())
  studio_id         String
  gallery_id        String
  project_id        String?
  client_id         String?
  created_by        String?
  name              String
  status            ProofingSessionStatus  @default(DRAFT)
  token_hash        String                 @unique
  pin_code_hash     String?
  expires_at        DateTime?
  submitted_at      DateTime?
  reviewed_at       DateTime?
  client_notes      String?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt @default(now())

  studio            Studio                 @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  gallery           Gallery                @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  project           StudioProject?         @relation(fields: [project_id], references: [id], onDelete: SetNull)
  client            Client?                @relation(fields: [client_id], references: [id], onDelete: SetNull)
  rules             ProofingSelectionRule?
  items             PhotoProofingItem[]
  comments          PhotoProofingComment[]
  comparisons       PhotoProofingComparison[]
  reviews           PhotoProofingReview[]
  audit_logs        PhotoProofingAuditLog[]
  fulfillment_orders FulfillmentOrder[]

  @@index([studio_id])
  @@index([gallery_id])
  @@index([project_id])
  @@index([client_id])
  @@index([token_hash])
  @@index([status])
  @@map("photo_proofing_sessions")
}

model ProofingSelectionRule {
  id                      String                @id @default(uuid())
  studio_id               String
  session_id              String                @unique
  included_count          Int                   @default(30)
  min_selections          Int                   @default(1)
  max_selections          Int?
  allow_extras            Boolean               @default(true)
  extra_price_cents       Int                   @default(1500) // $15.00 default in cents
  currency                String                @default("USD")
  require_exact_count     Boolean               @default(false)
  allow_cropping_requests Boolean               @default(true)
  allow_color_tags        Boolean               @default(true)
  allow_retouch_notes     Boolean               @default(true)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt @default(now())

  studio                  Studio                @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  session                 PhotoProofingSession  @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([session_id])
  @@map("proofing_selection_rules")
}

model PhotoProofingItem {
  id                String                 @id @default(uuid())
  studio_id         String
  session_id        String
  photo_id          String
  status            ProofingItemStatus     @default(UNREVIEWED)
  is_favorite       Boolean                @default(false)
  is_selected       Boolean                @default(false)
  client_rating     Int?                   // 1 to 5 stars
  client_color_tag  String?                // RED, GREEN, BLUE, YELLOW, PURPLE
  crop_preference   Json?                  // { x, y, width, height, aspect_ratio }
  retouch_notes     String?
  selection_rank    Int?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt @default(now())

  studio            Studio                 @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  session           PhotoProofingSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  photo             Photo                  @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  comments          PhotoProofingComment[]

  @@unique([session_id, photo_id])
  @@index([studio_id])
  @@index([session_id])
  @@index([photo_id])
  @@index([status])
  @@index([is_selected])
  @@index([is_favorite])
  @@map("photo_proofing_items")
}

model PhotoProofingComment {
  id                String                 @id @default(uuid())
  studio_id         String
  session_id        String
  proofing_item_id  String?
  photo_id          String
  author_type       String                 // CLIENT, PHOTOGRAPHER, STUDIO_STAFF
  author_name       String
  comment_type      ProofingCommentType    @default(GENERAL)
  pin_x             Float?                 // 0.0 - 1.0 (X percentage)
  pin_y             Float?                 // 0.0 - 1.0 (Y percentage)
  content           String
  is_resolved       Boolean                @default(false)
  resolved_by       String?
  resolved_at       DateTime?
  parent_id         String?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt @default(now())

  studio            Studio                 @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  session           PhotoProofingSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  proofing_item     PhotoProofingItem?     @relation(fields: [proofing_item_id], references: [id], onDelete: SetNull)
  photo             Photo                  @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
  @@index([session_id])
  @@index([photo_id])
  @@index([proofing_item_id])
  @@index([is_resolved])
  @@map("photo_proofing_comments")
}

model PhotoProofingComparison {
  id                String                 @id @default(uuid())
  studio_id         String
  session_id        String
  photo_ids         String[]               @default([])
  winner_photo_id   String?
  notes             String?
